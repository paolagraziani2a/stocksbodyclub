{
  "name": "plateforme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "vitest run --project db",
    "test:unit": "vitest run --project unit",
    "typecheck": "next typegen && tsc --noEmit",
    "demo": "node --env-file-if-exists=.env.local scripts/demo-data.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/migrate.mjs --seed",
    "admin:create": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "vercel-build": "node scripts/migrate.mjs --seed && next build"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "better-auth": "^1.7.25",
    "kysely": "^0.29.9",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
