# Copier en .env.local (jamais commité). Valeurs : tableau de bord Supabase et Stripe.

# --- Public (visible dans le navigateur : AUCUN secret ici) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secrets serveur ---
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# SMS d'annulation (Brevo) — sans clé, envois simulés
BREVO_API_KEY=
SMS_SENDER=BodyClub
# Protège les routes /api/cron/* (chaîne aléatoire longue)
CRON_SECRET=

# --- Tests base de données (PostgreSQL local) ---
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
