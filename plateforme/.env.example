# Copier en .env.local (jamais commité).

# --- Public (visible dans le navigateur : AUCUN secret ici) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de données Neon (chaîne « pooled » ; la « direct » sert aux migrations) ---
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Comptes (Better Auth) : chaîne aléatoire d'au moins 32 caractères (openssl rand -base64 32) ---
BETTER_AUTH_SECRET=
# Mettre « false » seulement en local pour se connecter sans confirmer son email
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# --- Emails et SMS (Brevo) — sans clé : envois simulés et journalisés ---
BREVO_API_KEY=
EMAIL_FROM=bonjour@votre-domaine.fr
EMAIL_FROM_NAME=The Body Club
SMS_SENDER=BodyClub

# --- Photos du site (Vercel Blob) — sans jeton en local : dossier public/uploads ---
BLOB_READ_WRITE_TOKEN=

# --- Paiement (étape suivante) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Protège les routes /api/cron/* (chaîne aléatoire longue)
CRON_SECRET=

# --- Tests base de données (PostgreSQL local) ---
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
